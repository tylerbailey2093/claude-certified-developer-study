---
// App shell: lakehouse grid background, left rail (Start menu, workspace links,
// domain catalog tree), sticky top bar, mobile drawer + bottom tab bar.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/drills.css';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import { DOMAINS } from '../lib/blueprint';
import SearchPalette from '../islands/SearchPalette.tsx';

interface Props {
  title: string;
  description?: string;
  activeObjective?: string;
  activeDomain?: number;
  crumbs?: { label: string; href?: string }[];
  /** Background intensity: hubs full, reading pages dim, running exam off. */
  grid?: 'full' | 'dim' | 'off';
  narrow?: boolean;
}

const {
  title,
  description = 'Original study platform for the Claude Certified Developer – Foundations (CCDV-F) exam.',
  activeObjective,
  activeDomain,
  crumbs = [],
  grid = 'dim',
  narrow = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const here = (seg: string) => (seg === '' ? path === base || path === base.replace(/\/$/, '') : path.startsWith(`${base}${seg}`));
const current = (seg: string) => (here(seg) ? 'page' : undefined);

const workspace = [
  { seg: '', label: 'Home', icon: 'home' },
  { seg: 'practice/', label: 'Practice', icon: 'practice' },
  { seg: 'exam/', label: 'Exam simulator', icon: 'exam' },
  { seg: 'labs/', label: 'Labs', icon: 'labs' },
  { seg: 'progress/', label: 'Progress', icon: 'progress' },
  { seg: 'strategy/', label: 'Strategy & logistics', icon: 'strategy' },
];
const reference = [
  { seg: 'sources/', label: 'Sources', icon: 'sources' },
  { seg: 'search/', label: 'Search', icon: 'search' },
  { seg: 'settings/', label: 'Settings', icon: 'settings' },
];
const tabs = [
  { seg: '', label: 'Home', icon: 'home' },
  { seg: 'practice/', label: 'Practice', icon: 'practice' },
  { seg: 'exam/', label: 'Exam', icon: 'exam' },
  { seg: 'labs/', label: 'Labs', icon: 'labs' },
  { seg: 'search/', label: 'Search', icon: 'search' },
];
const buildId = (import.meta.env.PUBLIC_BUILD_ID as string | undefined) ?? 'dev';
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} · CCDV-F Field Lab</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0B2026" />
  <link rel="icon" type="image/svg+xml" href={`${base}icons/icon.svg`} />
  <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
  <link rel="manifest" href={`${base}manifest.webmanifest`} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <link rel="preload" href={`${base}fonts/dm-sans-latin-wght-normal.woff2`} as="font" type="font/woff2" crossorigin />
  <script is:inline>
    // Theme before first paint: v2 prefs, then the v1 key, then dark.
    (function () {
      var d = document.documentElement;
      d.classList.add('js');
      var t = 'dark';
      try {
        var p = JSON.parse(localStorage.getItem('ccdvf:v2:prefs') || '{}');
        t = p.theme || localStorage.getItem('ccdvf:v1:theme') || 'dark';
      } catch (e) {}
      d.dataset.theme = t === 'light' ? 'light' : 'dark';
      if (!navigator.onLine) d.classList.add('is-offline');
    })();
  </script>
</head>
<body data-grid={grid} data-base={base} data-build={buildId}>
  <canvas id="lakehouse-grid" aria-hidden="true"></canvas>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="scrim" id="scrim" hidden></div>

  <div class="app">
    <aside class="rail" id="rail" aria-label="Site navigation">
      <a class="brand" href={base}>
        <BrandMark />
        <span>
          <span class="brand-name">CCDV-F Field Lab</span>
          <span class="brand-sub">Developer · Foundations</span>
        </span>
      </a>

      <details class="start" id="start-menu">
        <summary><Icon name="play" class="ri" /> Start</summary>
        <div class="start-menu" role="menu">
          <a role="menuitem" href={`${base}practice/?mode=weighted&n=10`}>Quick 10 (exam-weighted)</a>
          <a role="menuitem" href={`${base}practice/?mode=due`}>Due reviews <span class="badge" data-due-count></span></a>
          <a role="menuitem" href={`${base}practice/?mode=weak`}>Weak spots</a>
          <a role="menuitem" href={`${base}exam/`}>Exam simulator</a>
          <a role="menuitem" href={`${base}exam/`} data-resume-exam hidden>Resume exam <span class="badge">in progress</span></a>
        </div>
      </details>

      <div class="rail-sec">Workspace</div>
      {workspace.map((l) => (
        <a class="rail-link" href={`${base}${l.seg}`} aria-current={current(l.seg)}>
          <Icon name={l.icon} class="ri" />{l.label}
        </a>
      ))}

      <div class="rail-sec">Catalog</div>
      {DOMAINS.map((d) => (
        <details class="rail-tree" open={activeDomain === d.n} data-d={d.n}>
          <summary>
            <span class="rail-dom" aria-current={activeDomain === d.n && !activeObjective ? 'page' : undefined}>
              <span class="dot"></span>
              <span>D{d.n} · {d.name}</span>
              <span class="rw">{d.weight}%</span>
            </span>
          </summary>
          <a class="rail-obj" href={`${base}domain/${d.n}/`} aria-current={activeDomain === d.n && !activeObjective ? 'page' : undefined}>
            Domain overview
          </a>
          {[...d.objectives].sort((a, b) => b.weight - a.weight).map((o) => (
            <a class="rail-obj" href={`${base}objective/${o.id}/`} aria-current={activeObjective === o.id ? 'page' : undefined}>
              <span>{o.name}</span>
              <span class="mastery-dot" data-obj={o.id} title="Mastery"></span>
            </a>
          ))}
        </details>
      ))}

      <div class="rail-sec">Reference</div>
      {reference.map((l) => (
        <a class="rail-link" href={`${base}${l.seg}`} aria-current={current(l.seg)}>
          <Icon name={l.icon} class="ri" />{l.label}
        </a>
      ))}

      <div class="rail-foot">
        <span class="mono">build {buildId}</span>
      </div>
    </aside>

    <div class="main">
      <header class="topbar">
        <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-label="Open navigation" aria-controls="rail" aria-expanded="false">
          <Icon name="menu" />
        </button>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={base}>Home</a>
          {crumbs.map((c) => (
            <>
              <span class="sep">/</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
        <span class="spacer"></span>
        <span class="offline-badge" title="You are offline. Cached pages, practice and the exam still work.">offline</span>
        <a class="search-trigger" href={`${base}search/`} data-search-open>
          <Icon name="search" class="ri" /><span class="st-label">Search the guide</span><kbd>/</kbd>
        </a>
        <button class="icon-btn" id="motion-toggle" type="button" aria-pressed="true" aria-label="Background animation" title="Background animation">
          <Icon name="motion" class="when-on" /><Icon name="still" class="when-off" />
        </button>
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle light or dark theme" title="Theme">
          <span class="when-dark"><Icon name="sun" /></span>
        </button>
      </header>

      <main id="main" class:list={["content", { narrow }]} tabindex="-1" data-pagefind-body>
        <slot />
      </main>

      <footer class="sitefoot">
        <p>
          Original study material written against the CCDV-F Exam Guide v1.0 (July 2026). Every practice item is
          original; this site contains no real exam content.
        </p>
        <p>
          Independent project. Not affiliated with, endorsed by, or sponsored by Anthropic or Databricks. Visual style is
          lakehouse-inspired; all trademarks belong to their owners.
        </p>
      </footer>
    </div>
  </div>

  {!path.includes('/search') && <SearchPalette client:idle base={base} />}

  <nav class="tabbar" aria-label="Primary">
    {tabs.map((t) => (
      <a href={`${base}${t.seg}`} aria-current={current(t.seg)}>
        <Icon name={t.icon} />{t.label}
      </a>
    ))}
  </nav>

  <script>
    import '../scripts/lakehouse-grid.ts';
    import '../scripts/shell.ts';
    import '../scripts/sw-register.ts';
  </script>
</body>
</html>
