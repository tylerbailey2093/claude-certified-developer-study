---
// Generic node-and-grid glyph. Deliberately not derived from any third-party
// logo: the site is lakehouse-styled, not affiliated with anyone.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls = 'brand-mark' } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect x="1" y="1" width="30" height="30" rx="7" fill="var(--navy-800, #1b3139)" stroke="var(--border-strong, #3b5f6d)" />
  <path d="M8 1v30M16 1v30M24 1v30M1 8h30M1 16h30M1 24h30" stroke="rgba(160,196,216,.18)" stroke-width="1" />
  <path d="M8 24 16 16 24 8" stroke="#ff5f46" stroke-width="2" stroke-linecap="round" fill="none" />
  <circle cx="8" cy="24" r="2.6" fill="#f9f7f4" />
  <circle cx="16" cy="16" r="2.6" fill="#f9f7f4" />
  <circle cx="24" cy="8" r="3.2" fill="#ff3621" />
</svg>
