---
// <Flow title="Request path" steps={["Client", {label: "Claude API", note: "messages.create"}, "Tool"]} />
// Build-time SVG flow diagram: boxes joined by arrows, horizontal for up to 5
// steps, vertical beyond that. Themed via CSS variables, no JS, works offline.
interface StepObj {
  label: string;
  note?: string;
  kind?: 'client' | 'api' | 'model' | 'tool' | 'decision' | 'store' | 'guard';
}
interface Props {
  steps: (string | StepObj)[];
  title?: string;
  caption?: string;
}
const { steps: raw, title, caption } = Astro.props;
const steps: StepObj[] = raw.map((s) => (typeof s === 'string' ? { label: s } : s));
const vertical = steps.length > 5;
const CHAR = 6.9;
const wrap = (s: string, max: number) => {
  const words = s.split(/\s+/);
  const lines: string[] = [];
  let cur = '';
  for (const w of words) {
    if ((cur + ' ' + w).trim().length > max) {
      if (cur) lines.push(cur);
      cur = w;
    } else cur = (cur + ' ' + w).trim();
  }
  if (cur) lines.push(cur);
  return lines;
};
const BW = vertical ? 300 : Math.max(110, Math.min(150, Math.floor(680 / steps.length) - 30));
const maxChars = Math.floor((BW - 16) / CHAR);
const boxes = steps.map((s) => {
  const lines = wrap(s.label, maxChars);
  const notes = s.note ? wrap(s.note, Math.floor((BW - 16) / 6.2)) : [];
  return { ...s, lines, notes, h: 18 + lines.length * 16 + notes.length * 14 + (notes.length ? 4 : 0) };
});
const GAP = vertical ? 28 : 34;
const H = vertical ? boxes.reduce((s, b) => s + b.h + GAP, 0) - GAP + 8 : Math.max(...boxes.map((b) => b.h)) + 8;
const W = vertical ? BW + 8 : steps.length * BW + (steps.length - 1) * GAP + 8;
let y = 4;
let x = 4;
const placed = boxes.map((b) => {
  const p = { ...b, x: vertical ? 4 : x, y: vertical ? y : 4 + (H - 8 - b.h) / 2 };
  if (vertical) y += b.h + GAP;
  else x += BW + GAP;
  return p;
});
const label = title ?? `Flow: ${steps.map((s) => s.label).join(' → ')}`;
---
<figure class="diagram">
  {title && <figcaption class="diagram-title">{title}</figcaption>}
  <svg viewBox={`0 0 ${W} ${H}`} width={W} role="img" aria-label={label} class="flow">
    <defs>
      <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="arrowhead" />
      </marker>
    </defs>
    {placed.slice(0, -1).map((a, i) => {
      const b = placed[i + 1];
      return vertical ? (
        <line class="edge" x1={a.x + BW / 2} y1={a.y + a.h} x2={b.x + BW / 2} y2={b.y - 2} marker-end="url(#arrow)" />
      ) : (
        <line class="edge" x1={a.x + BW} y1={a.y + a.h / 2} x2={b.x - 2} y2={b.y + b.h / 2} marker-end="url(#arrow)" />
      );
    })}
    {placed.map((b) => (
      <g class={`node node-${b.kind ?? 'default'}`}>
        <rect x={b.x} y={b.y} width={BW} height={b.h} rx={b.kind === 'decision' ? 14 : 6} />
        {b.lines.map((l, i) => (
          <text class="node-label" x={b.x + BW / 2} y={b.y + 20 + i * 16} text-anchor="middle">{l}</text>
        ))}
        {b.notes.map((l, i) => (
          <text class="node-note" x={b.x + BW / 2} y={b.y + 22 + b.lines.length * 16 + i * 14} text-anchor="middle">{l}</text>
        ))}
      </g>
    ))}
  </svg>
  {caption && <figcaption class="diagram-caption">{caption}</figcaption>}
</figure>
