---
import Base from '../layouts/Base.astro';
import { allQuestions } from '../lib/bank/bank';
const base = import.meta.env.BASE_URL;
const n = allQuestions().filter((q) => q.status !== 'retired').length;
---
<Base title="Not found" grid="full" narrow>
  <header class="page-head">
    <p class="eyebrow">404 · stop_reason: page_not_found</p>
    <h1>That page is not in the catalog.</h1>
    <p class="lede">Doc paths move. So do study-site paths. Try one of these:</p>
  </header>
  <div class="btn-row">
    <a class="btn btn-run" href={base}>Home</a>
    <a class="btn" href={`${base}practice/`}>Practice ({n} items)</a>
    <a class="btn" href={`${base}exam/`}>Exam simulator</a>
    <a class="btn" href={`${base}search/`}>Search</a>
  </div>
</Base>
