---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import blueprint from '../../blueprint.json';
import Search from '../islands/Search.tsx';
import allQuestions from '../data/questions/all.json';

const base = import.meta.env.BASE_URL;
const objectives = await getCollection('objectives');

const domains = blueprint.domains
  .map((d) => ({ ...d, count: objectives.filter((o) => o.data.domain === d.n).length }))
  .sort((a, b) => b.weight - a.weight);

const maxW = Math.max(...domains.map((d) => d.weight));
const searchIndex = objectives.map((o) => ({
  id: o.data.id,
  name: o.data.name,
  domain: o.data.domain,
  weight: o.data.weight,
}));
---
<Base title="Field Manual">
  <header class="phead" style="padding-top:52px">
    <p class="eyebrow">Exam Guide v1.0 · Effective July 2026</p>
    <h1>A field manual for the Claude&nbsp;Certified Developer exam.</h1>
    <p class="lede">
      Eight domains, twenty-five scored objectives, {allQuestions.length} original practice items —
      every page weighted to the published blueprint. The cut score is 720 of 1000 and there is no
      per-domain minimum, so depth here follows exam weight rather than novelty.
    </p>
  </header>

  <div class="stat-strip">
    <div class="stat-cell"><b>53</b><span>Items</span></div>
    <div class="stat-cell"><b>120</b><span>Minutes</span></div>
    <div class="stat-cell"><b>720</b><span>Cut score</span></div>
    <div class="stat-cell"><b>25</b><span>Objectives</span></div>
    <div class="stat-cell"><b>{allQuestions.length}</b><span>Practice items</span></div>
  </div>

  <Search client:load index={searchIndex} baseUrl={base} />

  <p class="index-head">Contents · ordered by exam weight</p>
  <nav>
    {domains.map((d) => (
      <a class="dom-row" href={`${base}domain/${d.n}/`}>
        <span class="dom-n">{d.n}</span>
        <span>
          <span class="dom-name">{d.name}</span>
          <span class="dom-meta">{d.count} objective{d.count === 1 ? "" : "s"} · ~{d.approx_items} items</span>
        </span>
        <span>
          <span class="dom-weight">{d.weight}%</span>
          <span class="measure"><i style={`width:${(d.weight / maxW) * 100}%`}></i></span>
        </span>
      </a>
    ))}
  </nav>

  <p class="index-head" style="margin-top:60px">Drill</p>
  <nav>
    <a class="dom-row" href={`${base}quiz/`}>
      <span class="dom-n">§</span>
      <span>
        <span class="dom-name">Practice quiz</span>
        <span class="dom-meta">Filter by domain · immediate feedback · misses feed spaced repetition</span>
      </span>
      <span class="dom-weight">{allQuestions.length} items</span>
    </a>
    <a class="dom-row" href={`${base}mock/`}>
      <span class="dom-n">§</span>
      <span>
        <span class="dom-name">Timed mock exam</span>
        <span class="dom-meta">53 items sampled to blueprint · 120-minute countdown · explanations withheld</span>
      </span>
      <span class="dom-weight">Full sim</span>
    </a>
    <a class="dom-row" href={`${base}progress/`}>
      <span class="dom-n">§</span>
      <span>
        <span class="dom-name">Progress &amp; weakest objectives</span>
        <span class="dom-meta">Miss rates from real answers, not self-assessment</span>
      </span>
      <span class="dom-weight">Your data</span>
    </a>
  </nav>
</Base>
