---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import blueprint from '../../blueprint.json';
import Search from '../islands/Search.tsx';

const objectives = await getCollection('objectives');
const authoredCount = objectives.filter(o => o.data.authored).length;

const domains = blueprint.domains.map(d => ({
  ...d,
  path: `${import.meta.env.BASE_URL}domain/${d.n}/`,
}));
const maxW = Math.max(...domains.map(d => d.weight));
const searchIndex = objectives.map(o => ({ id: o.data.id, name: o.data.name, domain: o.data.domain, weight: o.data.weight }));
---
<Base title="Study Guide">
  <section class="hero">
    <h1>Claude Certified Developer &ndash; Foundations</h1>
    <p>
      8 domains, 25 scored objectives, weighted to the official exam blueprint (v1.0, effective
      July 2026). Cut score 720/1000, no per-domain minimum &mdash; effort here tracks blueprint
      weight, not novelty.
    </p>
    <div class="stat-row">
      <div class="stat" style="--c:var(--sky)"><b>53</b><span>exam items</span></div>
      <div class="stat" style="--c:var(--violet)"><b>120</b><span>minutes</span></div>
      <div class="stat" style="--c:var(--lime)"><b>720</b><span>cut score / 1000</span></div>
      <div class="stat" style="--c:var(--amber)"><b>25</b><span>objectives</span></div>
      <div class="stat" style="--c:var(--aqua)"><b>{authoredCount}/25</b><span>mastery-authored</span></div>
    </div>
  </section>

  <Search client:load index={searchIndex} baseUrl={import.meta.env.BASE_URL} />

  <section>
    <h2>Domains, by exam weight</h2>
    <div class="domain-list">
      {domains.map(d => (
        <a class="domain-row" href={d.path}>
          <span class="dn">D{d.n}</span>
          <span class="dname">{d.name}</span>
          <span class="wbar"><i style={`width:${(d.weight / maxW) * 100}%`}></i></span>
          <span class="dw">{d.weight}%</span>
        </a>
      ))}
    </div>
  </section>

  <section style="margin-top:36px">
    <h2>Drill</h2>
    <div class="obj-list">
      <a class="obj-row" href={`${import.meta.env.BASE_URL}quiz/`}><span>Practice quiz &mdash; by domain or pattern</span><span class="tier">64 items</span></a>
      <a class="obj-row" href={`${import.meta.env.BASE_URL}mock/`}><span>Timed mock exam &mdash; 53 items, 120 min</span><span class="tier">full sim</span></a>
      <a class="obj-row" href={`${import.meta.env.BASE_URL}progress/`}><span>Progress &amp; weakest objectives</span><span class="tier">your data</span></a>
    </div>
  </section>
</Base>
