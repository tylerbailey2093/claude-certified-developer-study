---
import Base from '../layouts/Base.astro';
import HomeDashboard from '../islands/HomeDashboard.tsx';
import PipelineMap from '../components/PipelineMap.astro';
import { DOMAINS } from '../lib/blueprint';
import { allQuestions } from '../lib/bank/bank';

const base = import.meta.env.BASE_URL;
const bank = allQuestions().filter((q) => q.status !== 'retired');
const poolSizes: Record<string, number> = {};
for (const q of bank) poolSizes[q.objective] = (poolSizes[q.objective] ?? 0) + 1;
const domains = [...DOMAINS].sort((a, b) => b.weight - a.weight);
const maxW = Math.max(...domains.map((d) => d.weight));
---
<Base title="Home" grid="full">
  <header class="page-head">
    <p class="eyebrow">Claude Certified Developer · Foundations · Exam Guide v1.0</p>
    <h1>Study for CCDV-F the way the exam is weighted.</h1>
    <p class="lede">
      53 items, 120 minutes, pass at 720 of 1000, and no per-domain minimum. Domain 2 alone is a third of the exam, so depth here
      follows the blueprint rather than what is interesting.
    </p>
  </header>

  <HomeDashboard client:load base={base} poolSizes={poolSizes} bankSize={bank.length} />

  <h2 style="margin-top:36px">Study path</h2>
  <PipelineMap />

  <h2>Domains by exam weight</h2>
  <div class="cards">
    {domains.map((d) => (
      <a class="card" href={`${base}domain/${d.n}/`} data-d={d.n}>
        <span class="tag tag-dom">D{d.n} · {d.weight}% · ~{d.approxItems} items</span>
        <h3>{d.name}</h3>
        <div class="meter" style="margin:10px 0 8px"><i style={`width:${(d.weight / maxW) * 100}%`}></i></div>
        <p>{d.objectives.length} objective{d.objectives.length === 1 ? '' : 's'}: {d.objectives.map((o) => o.name).join(', ')}</p>
      </a>
    ))}
  </div>

  <div class="callout callout-key" style="margin-top:28px">
    <p class="callout-title">The strategy in three numbers</p>
    <p><strong>Domain 2 is 33.1%</strong> (about 17 items). Claude Application Design at 8.6% is the single heaviest objective and has no dedicated lesson in the official course.</p>
    <p><strong>Domains 2 + 5 are 49.9%.</strong> Half the exam, and the half with the least carry-over from the Architect certification.</p>
    <p><strong>Domains 3 + 4 are 5.7%</strong> (about 3 items). Learn the vocabulary and move on.</p>
  </div>
</Base>
