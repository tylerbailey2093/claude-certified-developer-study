---
import Base from '../layouts/Base.astro';
import Update from '../partials/exam-update.mdx';
import FieldNotes from '../partials/field-notes.mdx';
import { V11_SKILLS, WEIGHTS_V11, OBJECTIVE_BY_ID, domainName } from '../lib/blueprint';

const base = import.meta.env.BASE_URL;
// Skills where v1.1 adds emphasis the v1.0 pages cover more thinly.
const emphasis = new Set([
  'Integration Resilience',
  'Evaluation Design',
  'Failure-Mode Diagnosis',
  'Cost Diagnosis and Optimization',
  'Grounding and Source Citation',
  'Claude Code Customization and Extension',
  'Capability Mechanism Selection',
  'Model Tier Selection and Release Planning',
]);
const byDomain = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => ({ n, skills: V11_SKILLS.filter((s) => s.domain === n) }));
const primers = import.meta.glob('../partials/v11-primers.mdx', { eager: true }) as Record<string, { default: any }>;
const Primers = Object.values(primers)[0]?.default;
---
<Base title="Dec 7 exam update" crumbs={[{ label: 'Dec 7 exam update' }]} grid="dim">
  <header class="page-head">
    <p class="eyebrow">Exam Guide v1.1 · effective December 7, 2026</p>
    <h1>The December 7 exam update</h1>
    <p class="lede">CCDV-F moves to 70 items and new domain weights. What changed, which version you sit, how to re-weight your study, and primers on the skills v1.1 adds weight to.</p>
  </header>
  <article class="prose">
    <Update />
    {byDomain.map(({ n, skills }) => (
      <section>
        <h3 data-d={n}>D{n} · {domainName(n)} · {WEIGHTS_V11[n]}%</h3>
        <div class="table-wrap">
          <table class="grid-table">
            <thead><tr><th>v1.1 skill</th><th>What it measures</th><th>Study</th></tr></thead>
            <tbody>
              {skills.map((s) => (
                <tr>
                  <td>{emphasis.has(s.name) ? <strong>{s.name}</strong> : s.name}</td>
                  <td>{s.guide}</td>
                  <td>
                    {s.maps_to.map((id, i) => {
                      const o = OBJECTIVE_BY_ID.get(id)!;
                      return <>{i ? ', ' : ''}<a class="objlink" data-d={o.domain} href={`${base}objective/${id}/`}>{o.name}</a></>;
                    })}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
    {Primers && <Primers />}
    <FieldNotes />
  </article>
</Base>
