---
import Base from '../layouts/Base.astro';
import ProgressDashboard from '../islands/ProgressDashboard.tsx';
import { allQuestions } from '../lib/bank/bank';
const base = import.meta.env.BASE_URL;
const poolSizes: Record<string, number> = {};
for (const q of allQuestions()) if (q.status !== 'retired') poolSizes[q.objective] = (poolSizes[q.objective] ?? 0) + 1;
---
<Base title="Progress" crumbs={[{ label: 'Progress' }]} grid="dim">
  <header class="page-head">
    <p class="eyebrow">Measured from your answers, not self-assessment</p>
    <h1>Progress</h1>
  </header>
  <ProgressDashboard client:load base={base} poolSizes={poolSizes} />
</Base>
