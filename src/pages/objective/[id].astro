---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import legacyHtml from '../../data/legacy-objectives.json';
import ConfidenceRating from '../../islands/ConfidenceRating.tsx';
import allQuestions from '../../data/questions/all.json';
import blueprint from '../../../blueprint.json';

export async function getStaticPaths() {
  const objectives = await getCollection('objectives');

  // Reading order across the whole manual: domain 1→8, and within a domain the
  // heaviest objective first. This is what drives the prev/next pager, so the
  // site reads as one sequence rather than 25 disconnected pages.
  const ordered = [...objectives].sort((a, b) =>
    a.data.domain - b.data.domain || b.data.weight - a.data.weight
  );

  return ordered.map((entry, i) => ({
    params: { id: entry.data.id },
    props: { entry, prev: ordered[i - 1] ?? null, next: ordered[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const base = import.meta.env.BASE_URL;
const { Content } = await render(entry);

const fallback = (legacyHtml as Record<string, string>)[data.id];
const itemCount = (allQuestions as { s: string }[]).filter((q) => q.s === data.name).length;
const domainName = blueprint.domains.find((d) => d.n === data.domain)?.name ?? '';

function hostOf(url: string) {
  try { return new URL(url).host.replace(/^www\./, ''); } catch { return ''; }
}
---
<Base
  title={data.name}
  activeDomain={data.domain}
  activeObjective={data.id}
  crumbs={[
    { label: 'Field Manual', href: base },
    { label: `D${data.domain} · ${domainName}`, href: `${base}domain/${data.domain}/` },
    { label: data.name },
  ]}
>
  <header class="phead">
    <p class="eyebrow">Domain {data.domain} · Objective</p>
    <h1>{data.name}</h1>
    {data.hot && <span class="flag">Heaviest single objective on the exam</span>}
  </header>

  <div class="obj-meta">
    <span>Weight <b>{data.weight}%</b></span>
    <span>Tier <b>{data.tier}</b></span>
    <span>Practice items <b>{itemCount}</b></span>
    {!data.authored && <span class="warn-flag">Legacy content — not yet expanded</span>}
  </div>

  <h3 style="margin-top:0">What this objective tests</h3>
  <ol class="scope-list">
    {data.scope.map((s: string) => <li><span>{s}</span></li>)}
  </ol>

  <article class="prose">
    {data.authored ? <Content /> : <div class="legacy-body" set:html={fallback} />}
  </article>

  {data.traps.length > 0 && (
    <section class="prose" style="margin-top:56px">
      <h2>Named traps</h2>
      <ol class="scope-list">
        {data.traps.map((t: string) => <li><span>{t}</span></li>)}
      </ol>
    </section>
  )}

  <ConfidenceRating client:load objective={data.name} />

  {data.sources.length > 0 && (
    <section>
      <p class="index-head">Sources</p>
      <ul class="src-list">
        {data.sources.map((s: { label: string; url: string }) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener">{s.label}</a>
            <span class="src-host">{hostOf(s.url)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <nav class="pager">
    {prev ? (
      <a href={`${base}objective/${prev.data.id}/`}>
        <span class="pg-label">← Previous</span>
        <span class="pg-title">{prev.data.name}</span>
      </a>
    ) : (
      <a href={base}>
        <span class="pg-label">← Back</span>
        <span class="pg-title pg-empty">Contents</span>
      </a>
    )}
    {next ? (
      <a href={`${base}objective/${next.data.id}/`}>
        <span class="pg-label">Next →</span>
        <span class="pg-title">{next.data.name}</span>
      </a>
    ) : (
      <a href={`${base}mock/`}>
        <span class="pg-label">Next →</span>
        <span class="pg-title">Sit the mock exam</span>
      </a>
    )}
  </nav>
</Base>
